# 环境变量键名示例（只有键名与无效示例值；真实值放宿主机 0600 .env，不入库）
# 面板
APP_ENV=development
APP_DATA_DIR=/data
STORAGE_BACKEND=smb-mounted
STORAGE_ROOT=<CONFIG_MOUNT>
YAML_PATH=<MAIN_YAML_FILENAME>
WRITE_ENABLED=false
PUBLIC_FILE_BASE_URL=https://<PUBLIC_FILE_DOMAIN>
FRONTEND_DIST=/app/frontend/dist

# WebDAV（如启用）
WEBDAV_URL=https://dav.example.com
WEBDAV_USERNAME=<EXAMPLE_USERNAME>
WEBDAV_PASSWORD=<EXAMPLE_PASSWORD>
WEBDAV_YAML_PATH=<MAIN_YAML_FILENAME>

# 服务商流量 API（凭据只留宿主机；注意 IP 白名单）
VULTR_API_KEY=<EXAMPLE_VULTR_API_KEY>
EVOXT_USERNAME=<EXAMPLE_EVOXT_USERNAME>
EVOXT_API_PUBLIC=<EXAMPLE_EVOXT_PUBLIC_KEY>
EVOXT_API_PRIVATE=<EXAMPLE_EVOXT_PRIVATE_KEY>
EVOXT_SERVICE_ID=<EXAMPLE_SERVICE_ID>

# 订阅发布（规划中，见 roadmap/01）
SUBSCRIPTION_TOKEN_HASH_ALG=sha256
SUBSCRIPTION_RENDER_CACHE_TTL=60
SUBSCRIPTION_DEFAULT_EXPIRE_DAYS=0
