# 面板
PANEL_PORT=8787
# 可填写 NAS 局域网 IP；留空或 0.0.0.0 表示监听 NAS 所有接口
PANEL_BIND_IP=192.0.2.10
CONTAINER_NAME=fixcloud-panel
# FixCloud 专用双栈 bridge；不要与 NAS 现有 Docker 网段重复。
FIXCLOUD_IPV4_SUBNET=10.0.8.0/24
FIXCLOUD_IPV6_SUBNET=fd00::1::/64
APP_ENV=production
APP_DATA_DIR=/data
APP_DATA_HOST_PATH=/share/Container/FixCloudPanel/data
PUID=1000
PGID=100

# 默认来源：NAS 主机已挂载的 SMB/共享目录
# 如果 Docker 和文件位于同一台 NAS，优先填写共享目录的真实主机路径。
SMB_MOUNT_PATH=/share/BeamJason/files/config
STORAGE_BACKEND=smb-mounted
STORAGE_ROOT=/mnt/fixcloud
YAML_PATH=/FixCloud.yaml
YAML_MOUNT_READ_ONLY=false
WRITE_ENABLED=true

# 设置页“公开文件服务”入口与线上 YAML 哈希核对地址
PUBLIC_FILE_BASE_URL=https://file.example.com
# 容器内解析公开域名用的局域网地址（写进 /etc/hosts 的 extra_hosts）。
# 面板容器在专用 bridge 上只有内部 IPv6，且宿主机没有 NAT66，无法直连域名背后的公网 IPv6；
# 指向 bridge 的 IPv6 网关即可由宿主机 Lucky 本地投递（需要 Lucky 用 host 网络监听 443）。
# 若你的公开域名有可直连的 IPv4/IPv6，可删除 docker-compose.yml 里的 extra_hosts。
PUBLIC_FILE_DOMAIN=file.example.com
PUBLIC_FILE_LAN_IPV6=fd00::1
